{
  "all": true,
  "extension": [".js"],
  "include": ["dist/cjs/**/*.js"],
  "exclude": ["tests/**", "reference/**"],
  "reporter": ["text", "lcov"],
  "report-dir": "coverage",
  "check-coverage": true,
  "statements": 88,
  "branches": 76,
  "functions": 90,
  "lines": 90,
  "exclude-after-remap": false
}
